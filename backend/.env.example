APP_NAME=SILAKH
# Produksi: APP_ENV=production dan APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jayapura

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Produksi: warning
LOG_LEVEL=debug

# Lokal boleh sqlite; produksi (Hostinger) memakai mysql.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_silakh
# DB_USERNAME=u123456789_silakh
# DB_PASSWORD=

# Sesi cookie untuk SPA (Sanctum). Produksi: SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Domain yang dianggap SPA pihak pertama (tanpa skema). Produksi: domain situs Anda.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# Shared hosting tidak menjalankan worker antrean.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# Aturan aplikasi
SILAKH_LOCK_GRACE_DAY=5
SILAKH_EXPORT_MAX_ROWS=5000
SILAKH_PDF_MAX_ROWS=1000

# Pilihan jam kegiatan pada formulir laporan
SILAKH_JAM_MULAI=07:30
SILAKH_JAM_SELESAI=16:30
SILAKH_JAM_INTERVAL=30

# Administrator awal, dipakai sekali oleh `php artisan db:seed`.
# Kosongkan ADMIN_PASSWORD setelah akun dibuat. Alternatif: php artisan silakh:create-admin
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
